# ── SolarSense environment variables ──
# Copy this file to `.env.local` for local dev, and set the SAME keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER put real values in this file — it is committed to git as a template only.
# `.env.local` (with real values) is gitignored and must never be committed.

# Supabase — from Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin token for exporting leads — set to any long random string
LEADS_ADMIN_TOKEN=make-this-a-long-random-string
